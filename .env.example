# Frontend (públicas — também configurar na Vercel)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Somente para backend / Serverless Functions (NUNCA prefixar com VITE_)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Integração Mercado Pago / Mercado Livre (Pix + Webhook)
MP_ACCESS_TOKEN=APP_USR-ou-TEST-seu-token
MP_WEBHOOK_SECRET=seu-segredo-webhook-mercadopago

# Integração Evolution API (VPS própria - WhatsApp via QR Code)
EVOLUTION_API_URL=https://sua-evolution.seudominio.com
EVOLUTION_API_KEY=sua-global-api-key
EVOLUTION_INSTANCE=leooticas
EVOLUTION_WEBHOOK_SECRET=segredo-opcional-webhook-evolution

# Segurança de Crons e IA (opcional para transcrição de áudio / extração de promessas)
CRON_SECRET=segredo-para-chamar-rotinas-agendadas
GEMINI_API_KEY=opcional-chave-google-gemini
APP_BASE_URL=https://sua-url-preview-ou-producao.vercel.app
